{
  "name": "Selkies Cloud Desktop",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [
    8090,
    8080
  ],
  "portsAttributes": {
    "8090": {
      "label": "Panel Selkies",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    },
    "8080": {
      "label": "Escritorio Selkies",
      "onAutoForward": "silent",
      "protocol": "http"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/start-control-panel.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
